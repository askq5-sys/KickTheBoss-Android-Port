diff --git a/guest/compat/zbcompat.c b/guest/compat/zbcompat.c
index f903d74..8ad0946 100644
--- a/guest/compat/zbcompat.c
+++ b/guest/compat/zbcompat.c
@@ -15,3 +15,67 @@ long long __aeabi_d2lz(double value) {
     unsigned long long result = ((unsigned long long)high << 32) | low;
     return negative ? -(long long)result : (long long)result;
 }
+
+
+/* zb-stdio-seek: fopen for games with their own copy of the old BSD stdio (see
+ * tools/../zb_stdio_seek.py). Classic 32-bit FILE layout, which bionic keeps for LP32. */
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <unistd.h>
+
+struct zb_old_sbuf {
+    unsigned char* base;
+    int size;
+};
+
+struct zb_old_file {
+    unsigned char* p;
+    int r;
+    int w;
+    short flags;
+    short file;
+    struct zb_old_sbuf bf;
+    int lbfsize;
+    void* cookie;
+    int (*close_fn)(void*);
+    int (*read_fn)(void*, char*, int);
+    long (*seek_fn)(void*, long, int);
+    int (*write_fn)(void*, const char*, int);
+};
+
+_Static_assert(sizeof(void*) == 4, "the classic FILE layout is the 32-bit one");
+_Static_assert(__builtin_offsetof(struct zb_old_file, seek_fn) == 40, "FILE::_seek offset");
+
+static long zb_old_sseek(void* cookie, long offset, int whence) {
+    const struct zb_old_file* fp = (const struct zb_old_file*)cookie;
+    return (long)lseek(fp->file, (off_t)offset, whence);
+}
+
+/* Not named fopen: zbhost binds it into libraries with the old static stdio. */
+FILE* zb_classic_fopen(const char* path, const char* mode) {
+    int flags;
+    switch (mode[0]) {
+    case 'r': flags = O_RDONLY; break;
+    case 'w': flags = O_WRONLY | O_CREAT | O_TRUNC; break;
+    case 'a': flags = O_WRONLY | O_CREAT | O_APPEND; break;
+    default: errno = EINVAL; return NULL;
+    }
+    for (const char* m = mode + 1; *m != '\0'; ++m) {
+        if (*m == '+') flags = (flags & ~O_ACCMODE) | O_RDWR;
+        else if (*m == 'e') flags |= O_CLOEXEC;
+        else if (*m == 'x') flags |= O_EXCL;
+    }
+    const int fd = open(path, flags | O_LARGEFILE, 0666);
+    if (fd < 0) return NULL;
+    FILE* fp = fdopen(fd, mode);
+    if (fp == NULL) {
+        const int saved = errno;
+        close(fd);
+        errno = saved;
+        return NULL;
+    }
+    struct zb_old_file* old = (struct zb_old_file*)fp;
+    if (old->seek_fn == NULL && old->cookie == (void*)fp) old->seek_fn = zb_old_sseek;
+    return fp;
+}
