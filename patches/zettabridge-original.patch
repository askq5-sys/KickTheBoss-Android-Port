diff --git a/android/launcher/app/src/main/java/com/zettabridge/launcher/MonoAssetCompat.java b/android/launcher/app/src/main/java/com/zettabridge/launcher/MonoAssetCompat.java
new file mode 100644
index 0000000..4edbe6c
--- /dev/null
+++ b/android/launcher/app/src/main/java/com/zettabridge/launcher/MonoAssetCompat.java
@@ -0,0 +1,81 @@
+package com.zettabridge.launcher;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.util.Enumeration;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipFile;
+
+/**
+ * Unity 4 Mono opens assemblies as ordinary filesystem paths, but on current
+ * Android the plugin APK is an opaque ZIP. Make an on-disk mirror of ONLY the
+ * Unity managed DLLs, leaving assets and all game data in the real APK.
+ */
+final class MonoAssetCompat {
+    private static final String PREFIX = "assets/bin/Data/Managed/";
+
+    private MonoAssetCompat() {}
+
+    static void ensure(PluginRecord record) throws IOException {
+        File root = new File(record.dir, "zb-asset-files/assets/bin/Data/Managed");
+        if (!root.isDirectory() && !root.mkdirs())
+            throw new IOException("Cannot create Unity Mono mirror " + root);
+        boolean sawMscorlib = false;
+        try (ZipFile zip = new ZipFile(record.apk())) {
+            Enumeration<? extends ZipEntry> entries = zip.entries();
+            while (entries.hasMoreElements()) {
+                ZipEntry entry = entries.nextElement();
+                String path = entry.getName();
+                if (entry.isDirectory() || !path.startsWith(PREFIX)) continue;
+                String name = path.substring(PREFIX.length());
+                if (name.isEmpty() || name.equals(".") || name.equals("..") ||
+                    name.contains("/") || name.contains("\\") || !name.endsWith(".dll")) continue;
+                copy(zip, entry, new File(root, name));
+                if (name.equals("mscorlib.dll")) {
+                    sawMscorlib = true;
+                    // Mono also looks for its corelib in mono/2.0/mscorlib.dll.
+                    copy(zip, entry, new File(root, "mono/2.0/mscorlib.dll"));
+                }
+            }
+        }
+        // Other 32-bit plugins need not be Unity/Mono; no corelib is fine.
+        if (sawMscorlib) android.util.Log.i("zb-mono-compat",
+                "Unity Mono assemblies mirrored to " + root.getAbsolutePath());
+    }
+
+    private static void copy(ZipFile zip, ZipEntry entry, File out) throws IOException {
+        // zb-opt-r2: a same-size DLL with other content (a patched build) must be refreshed too,
+        // so the copy is stamped with the entry's CRC.
+        File stamp = new File(out.getParentFile(), out.getName() + ".zb-crc");
+        String want = Long.toHexString(entry.getCrc()) + ":" + entry.getSize();
+        if (out.isFile() && out.length() == entry.getSize() && stamp.isFile()) {
+            try {
+                String have = new String(java.nio.file.Files.readAllBytes(stamp.toPath()),
+                        java.nio.charset.StandardCharsets.US_ASCII).trim();
+                if (want.equals(have)) return;
+            } catch (IOException ignored) {
+                // unreadable stamp: copy again
+            }
+        }
+        File parent = out.getParentFile();
+        if (!parent.isDirectory() && !parent.mkdirs())
+            throw new IOException("Cannot create " + parent);
+        File tmp = new File(parent, out.getName() + ".zb-tmp");
+        try (InputStream in = zip.getInputStream(entry);
+             OutputStream stream = new FileOutputStream(tmp)) {
+            byte[] buffer = new byte[65536];
+            int read;
+            while ((read = in.read(buffer)) >= 0) {
+                if (read > 0) stream.write(buffer, 0, read);
+            }
+        }
+        if (out.exists() && !out.delete())
+            throw new IOException("Cannot replace " + out);
+        if (!tmp.renameTo(out))
+            throw new IOException("Cannot rename " + tmp + " to " + out);
+        java.nio.file.Files.write(stamp.toPath(), want.getBytes(java.nio.charset.StandardCharsets.US_ASCII));
+    }
+}
