+// Size of the compressed data of one image (GL_IMG_texture_compression_pvrtc).
+inline std::size_t data_size(int width, int height, int bpp) {
+    const std::size_t w = std::size_t(std::max(width, bpp == 2 ? 16 : 8));
+    const std::size_t h = std::size_t(std::max(height, 8));
+    return w * h * std::size_t(bpp) / 8;
