+    auto word = [&](int wy, int wx) {
+        const std::uint8_t* p = src + 8u * twiddle(std::uint32_t(ny), std::uint32_t(nx), std::uint32_t(wy), std::uint32_t(wx));
+        Word w;
+        std::memcpy(&w.modulation, p, 4);
+        std::memcpy(&w.color, p + 4, 4);
+        return w;
+    };
+    for (int wy = -1; wy < ny - 1; ++wy) {
+        for (int wx = -1; wx < nx - 1; ++wx) {
+            const int py = (wy + ny) % ny, px = (wx + nx) % nx, ry = (wy + 1) % ny, qx = (wx + 1) % nx;
+            const Word P = word(py, px), Q = word(py, qx), R = word(ry, px), S = word(ry, qx);
+            unpack_modulations(P, 0, 0, values, modes, bpp);
+            unpack_modulations(Q, ww, 0, values, modes, bpp);
+            unpack_modulations(R, 0, wh, values, modes, bpp);
+            unpack_modulations(S, ww, wh, values, modes, bpp);
+            interpolate(color_a(P.color), color_a(Q.color), color_a(R.color), color_a(S.color), ua, bpp);
+            interpolate(color_b(P.color), color_b(Q.color), color_b(R.color), color_b(S.color), ub, bpp);
+            Pixel32 block[32];
+            for (int y = 0; y < wh; ++y)
+                for (int x = 0; x < ww; ++x) {
+                    std::int32_t m = modulation(values, modes, x + ww / 2, y + wh / 2, bpp);
+                    bool punch = false;
+                    if (m > 10) { punch = true; m -= 10; }
+                    const Pixel128& a = ua[y * ww + x];
+                    const Pixel128& b = ub[y * ww + x];
+                    Pixel32& o = block[y * ww + x];
+                    o.r = std::uint8_t((a.r * (8 - m) + b.r * m) / 8);
+                    o.g = std::uint8_t((a.g * (8 - m) + b.g * m) / 8);
