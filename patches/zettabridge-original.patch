+inline void unpack_modulations(const Word& w, int ox, int oy, std::int32_t values[16][8], std::int32_t modes[16][8], int bpp) {
+    std::uint32_t mode = w.color & 1u;
+    std::uint32_t bits = w.modulation;
+    if (bpp == 2) {
+        if (mode) {
+            if (bits & 1u) {
+                mode = (bits & (1u << 20)) ? 3 : 2;
+                if (bits & (1u << 21)) bits |= (1u << 20); else bits &= ~(1u << 20);
+            }
+            if (bits & 2u) bits |= 1u; else bits &= ~1u;
+            for (int y = 0; y < 4; ++y)
+                for (int x = 0; x < 8; ++x) {
+                    modes[x + ox][y + oy] = std::int32_t(mode);
+                    if (((x ^ y) & 1) == 0) { values[x + ox][y + oy] = std::int32_t(bits & 3u); bits >>= 2; }
+                }
