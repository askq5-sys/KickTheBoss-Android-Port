diff --git a/guest/zbhost/zbhost.c b/guest/zbhost/zbhost.c
index df1e66f..e19a848 100644
--- a/guest/zbhost/zbhost.c
+++ b/guest/zbhost/zbhost.c
@@ -29,8 +29,118 @@ static uint32_t host_call(uint32_t index, uint32_t arg) {
     return r0;
 }
 
+/* zb-stdio-seek: libraries with their own copy of the old BSD stdio (Unreal Engine 3 and other
+ * NDK r4-r8 era code) seek through FILE::_seek, which modern bionic's fopen leaves NULL. Their
+ * imported fopen is pointed at zb_classic_fopen (libzbcompat.so), which fills it. */
+#include <elf.h>
+#include <link.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#ifndef R_ARM_GLOB_DAT
+#define R_ARM_GLOB_DAT 21
+#endif
+#ifndef R_ARM_JUMP_SLOT
+#define R_ARM_JUMP_SLOT 22
+#endif
+
+static uintptr_t zb_stdio_seen[128];
+static int zb_stdio_seen_count;
+
+static int (*zb_stdio_print)(int, const char*, const char*, ...);
+static void* zb_stdio_classic;
+
+/* Resolved before dl_iterate_phdr: the callback runs under the linker's lock. */
+static void zb_stdio_prepare(void) {
+    if (zb_stdio_classic == NULL) zb_stdio_classic = dlsym(RTLD_DEFAULT, "zb_classic_fopen");
+    if (zb_stdio_print == NULL) {
+        void* liblog = dlopen("liblog.so", RTLD_NOW);
+        if (liblog != NULL) {
+            zb_stdio_print = (int (*)(int, const char*, const char*, ...))dlsym(liblog, "__android_log_print");
+        }
+    }
+}
+
+static void zb_stdio_log(const char* name, int slots) {
+    if (zb_stdio_print != NULL) zb_stdio_print(4, "zbhost", "classic stdio for %s: %d fopen slot(s)", name, slots);
+}
+
+static int zb_stdio_patch_relocs(uintptr_t base, const Elf32_Rel* rel, size_t size, const Elf32_Sym* symtab,
+                                 const char* strtab, void* classic) {
+    int patched = 0;
+    const long page = sysconf(_SC_PAGESIZE);
+    for (size_t i = 0; rel != NULL && i < size / sizeof(Elf32_Rel); ++i) {
+        const unsigned type = ELF32_R_TYPE(rel[i].r_info);
+        const Elf32_Sym* sym = &symtab[ELF32_R_SYM(rel[i].r_info)];
+        if ((type != R_ARM_JUMP_SLOT && type != R_ARM_GLOB_DAT) || sym->st_shndx != SHN_UNDEF) continue;
+        if (strcmp(strtab + sym->st_name, "fopen") != 0) continue;
+        void** slot = (void**)(base + rel[i].r_offset);
+        void* first = (void*)((uintptr_t)slot & ~(uintptr_t)(page - 1));
+        if (mprotect(first, (size_t)page, PROT_READ | PROT_WRITE) != 0) continue;
+        *slot = classic;
+        ++patched;
+    }
+    return patched;
+}
+
+static int zb_stdio_object(struct dl_phdr_info* info, size_t size, void* data) {
+    (void)size;
+    (void)data;
+    const uintptr_t base = (uintptr_t)info->dlpi_addr;
+    for (int i = 0; i < zb_stdio_seen_count; ++i) {
+        if (zb_stdio_seen[i] == base) return 0;
+    }
+    if (zb_stdio_seen_count < (int)(sizeof(zb_stdio_seen) / sizeof(zb_stdio_seen[0]))) {
+        zb_stdio_seen[zb_stdio_seen_count++] = base;
+    }
+    const Elf32_Dyn* dyn = NULL;
+    for (int i = 0; i < info->dlpi_phnum; ++i) {
+        if (info->dlpi_phdr[i].p_type == PT_DYNAMIC) dyn = (const Elf32_Dyn*)(base + info->dlpi_phdr[i].p_vaddr);
+    }
+    if (dyn == NULL) return 0;
+    const Elf32_Sym* symtab = NULL;
+    const char* strtab = NULL;
+    const Elf32_Word* hash = NULL;
+    const Elf32_Rel* jmprel = NULL;
+    const Elf32_Rel* rel = NULL;
+    size_t jmprel_size = 0, rel_size = 0;
+    for (const Elf32_Dyn* d = dyn; d->d_tag != DT_NULL; ++d) {
+        switch (d->d_tag) {
+        case DT_SYMTAB: symtab = (const Elf32_Sym*)(base + d->d_un.d_ptr); break;
+        case DT_STRTAB: strtab = (const char*)(base + d->d_un.d_ptr); break;
+        case DT_HASH: hash = (const Elf32_Word*)(base + d->d_un.d_ptr); break;
+        case DT_JMPREL: jmprel = (const Elf32_Rel*)(base + d->d_un.d_ptr); break;
+        case DT_PLTRELSZ: jmprel_size = d->d_un.d_val; break;
+        case DT_REL: rel = (const Elf32_Rel*)(base + d->d_un.d_ptr); break;
+        case DT_RELSZ: rel_size = d->d_un.d_val; break;
+        default: break;
+        }
+    }
+    if (symtab == NULL || strtab == NULL || hash == NULL) return 0;
+    int has_fseeko = 0, has_sdidinit = 0;
+    for (Elf32_Word i = 1; i < hash[1]; ++i) {
+        if (symtab[i].st_shndx == SHN_UNDEF) continue;
+        const char* name = strtab + symtab[i].st_name;
+        if (strcmp(name, "fseeko") == 0) has_fseeko = 1;
+        else if (strcmp(name, "__sdidinit") == 0) has_sdidinit = 1;
+    }
+    if (!has_fseeko || !has_sdidinit) return 0;
+    void* classic = zb_stdio_classic;
+    if (classic == NULL) return 0;
+    const int slots = zb_stdio_patch_relocs(base, jmprel, jmprel_size, symtab, strtab, classic) +
+                      zb_stdio_patch_relocs(base, rel, rel_size, symtab, strtab, classic);
+    zb_stdio_log(info->dlpi_name != NULL ? info->dlpi_name : "?", slots);
+    return 0;
+}
+
 static uint32_t service_dlopen(const char* path, uint32_t flags) {
-    return (uint32_t)(uintptr_t)dlopen(path, (int)flags);
+    void* handle = dlopen(path, (int)flags);
+    if (handle != NULL) {  /* zb-stdio-seek */
+        zb_stdio_prepare();
+        dl_iterate_phdr(zb_stdio_object, NULL);
+    }
+    return (uint32_t)(uintptr_t)handle;
 }
 
 static uint32_t service_dlsym(uint32_t handle, const char* name) {
