+inline std::uint32_t twiddle(std::uint32_t ysize, std::uint32_t xsize, std::uint32_t y, std::uint32_t x) {
+    std::uint32_t out = 0, min_dim = xsize, max_value = y, src = 1, dst = 1, shift = 0;
+    if (ysize < xsize) { min_dim = ysize; max_value = x; }
+    while (src < min_dim) {
+        if (y & src) out |= dst;
+        if (x & src) out |= dst << 1;
+        src <<= 1; dst <<= 2; ++shift;
+    }
+    return out | ((max_value >> shift) << (2 * shift));
+}
