+                    full[std::size_t((py * wh + y + wh / 2) * xdim + px * ww + x + ww / 2)] = block[y * ww + x];
+                    full[std::size_t((py * wh + y + wh / 2) * xdim + qx * ww + x)] = block[y * ww + x + ww / 2];
+                    full[std::size_t((ry * wh + y) * xdim + px * ww + x + ww / 2)] = block[(y + wh / 2) * ww + x];
+                    full[std::size_t((ry * wh + y) * xdim + qx * ww + x)] = block[(y + wh / 2) * ww + x + ww / 2];
+                }
+        }
+    }
+    for (int y = 0; y < height; ++y)
+        for (int x = 0; x < width; ++x) {
+            const Pixel32& p = full[std::size_t(y * xdim + x)];
+            std::uint8_t* o = rgba + 4 * (std::size_t(y) * std::size_t(width) + std::size_t(x));
+            o[0] = p.r; o[1] = p.g; o[2] = p.b; o[3] = opaque ? 0xff : p.a;
+        }
