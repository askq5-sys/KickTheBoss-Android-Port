+                modes[x + ox][y + oy] = std::int32_t(mode);
+                std::int32_t v = std::int32_t(bits & 3u);
+                if (mode) { if (v == 1) v = 4; else if (v == 2) v = 14; else if (v == 3) v = 8; }
