+                    modes[x + ox][y + oy] = std::int32_t(mode);
+                    values[x + ox][y + oy] = (bits & 1u) ? 3 : 0;
+                    bits >>= 1;
+                }
+        }
+    } else {
+        for (int y = 0; y < 4; ++y)
