+    const Pixel128 sr{hs.r - hr.r, hs.g - hr.g, hs.b - hr.b, hs.a - hr.a};
+    hp = {hp.r * ww, hp.g * ww, hp.b * ww, hp.a * ww};
+    hr = {hr.r * ww, hr.g * ww, hr.b * ww, hr.a * ww};
+    for (int x = 0; x < ww; ++x) {
+        Pixel128 res{4 * hp.r, 4 * hp.g, 4 * hp.b, 4 * hp.a};
+        const Pixel128 dy{hr.r - hp.r, hr.g - hp.g, hr.b - hp.b, hr.a - hp.a};
