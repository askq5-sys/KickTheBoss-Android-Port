+// Decodes to tightly packed RGBA8, width x height.
+inline void decode(const std::uint8_t* src, int width, int height, int bpp, bool opaque, std::uint8_t* rgba) {
+    const int ww = bpp == 2 ? 8 : 4, wh = 4;
+    const int xdim = std::max(width, bpp == 2 ? 16 : 8), ydim = std::max(height, 8);
