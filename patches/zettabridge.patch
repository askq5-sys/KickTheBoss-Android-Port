diff --git a/android/launcher/app/src/kicktheboss/java/com/zettabridge/launcher/BundledGameActivity.java b/android/launcher/app/src/kicktheboss/java/com/zettabridge/launcher/BundledGameActivity.java
new file mode 100644
--- /dev/null
+++ b/android/launcher/app/src/kicktheboss/java/com/zettabridge/launcher/BundledGameActivity.java
@@ -0,0 +1,117 @@
+package com.zettabridge.launcher;
+
+import android.app.Activity;
+import android.content.Intent;
+import android.content.SharedPreferences;
+import android.graphics.Color;
+import android.os.Bundle;
+import android.view.Gravity;
+import android.widget.TextView;
+
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.Locale;
+
+/**
+ * Home-screen entry of a single-game build. The game APK ships as an asset; it is imported through
+ * the normal plugin import on first launch and again only when the bundled copy changes (its
+ * version file differs). Import keeps the plugin's data directory, so saves survive updates.
+ */
+public class BundledGameActivity extends Activity {
+    private static final String ASSET_APK = "bundled/game.apk";
+    private static final String ASSET_VERSION = "bundled/game.version";
+    private static final String PREFS = "bundled-game";
+
+    private TextView status;
+
+    @Override
+    protected void onCreate(Bundle state) {
+        super.onCreate(state);
+        final String wanted;
+        try {
+            wanted = readAsset(ASSET_VERSION).trim();
+        } catch (IOException e) {
+            fail("The game is not bundled in this build: " + e.getMessage());
+            return;
+        }
+        final SharedPreferences prefs = getSharedPreferences(PREFS, MODE_PRIVATE);
+        final String pkg = prefs.getString("package", null);
+        final PluginRecord installed = pkg != null ? PluginStore.find(this, pkg) : null;
+        if (installed != null && installed.isLaunchable() && wanted.equals(prefs.getString("version", null))) {
+            launch(pkg);
+            return;
+        }
+        status = new TextView(this);
+        status.setTextColor(Color.WHITE);
+        status.setBackgroundColor(Color.BLACK);
+        status.setGravity(Gravity.CENTER);
+        status.setTextSize(18);
+        status.setText(progressText(installed == null));  // zb-ui: localized
+        setContentView(status);
+        new Thread(() -> {
+            try {
+                PluginRecord r = PluginStore.importStream(this, getAssets().open(ASSET_APK));
+                prefs.edit().putString("package", r.packageName).putString("version", wanted).commit();
+                runOnUiThread(() -> launch(r.packageName));
+            } catch (Exception e) {
+                runOnUiThread(() -> fail("Cannot prepare the game: " + e));
+            }
+        }, "zb-bundled-import").start();
+    }
+
+    private void launch(String packageName) {
+        startActivity(PluginSwitchActivity.intent(this, packageName));
+        finishAndRemoveTask();  // zb-ui: the game's own task is the only one in Recents
+    }
+
+    private void fail(String message) {
+        Diagnostics.report(this, message, null, false);
+        TextView t = status != null ? status : new TextView(this);
+        t.setText(message + "\n\nTap to open the ZettaBridge library.");
+        t.setOnClickListener(v -> {
+            startActivity(new Intent(this, LibraryActivity.class));
+            finish();
+        });
+        if (status == null) {
+            t.setGravity(Gravity.CENTER);
+            setContentView(t);
+        }
+    }
+
+    /** zb-ui: the progress line in the phone language (the game's ten languages, else English). */
+    private static String progressText(boolean firstLaunch) {
+        Locale l = Locale.getDefault();
+        String lang = l.getLanguage();
+        if ("zh".equals(lang)) {
+            String script = l.getScript();
+            String country = l.getCountry();
+            boolean hant = "Hant".equals(script) || (script.isEmpty()
+                    && ("TW".equals(country) || "HK".equals(country) || "MO".equals(country)));
+            lang = hant ? "zh-Hant" : "zh-Hans";
+        }
+        switch (lang) {
+            case "ru": return firstLaunch ? "Подготовка игры (первый запуск)..." : "Обновление игры...";
+            case "zh-Hant": return firstLaunch ? "正在準備遊戲（首次啟動）..." : "正在更新遊戲...";
+            case "zh-Hans": return firstLaunch ? "正在准备游戏（首次启动）..." : "正在更新游戏...";
+            case "ja": return firstLaunch ? "ゲームを準備しています（初回起動）..." : "ゲームを更新しています...";
+            case "es": return firstLaunch ? "Preparando el juego (primer inicio)..." : "Actualizando el juego...";
+            case "fr": return firstLaunch ? "Préparation du jeu (premier lancement)..." : "Mise à jour du jeu...";
+            case "de": return firstLaunch ? "Spiel wird vorbereitet (erster Start)..." : "Spiel wird aktualisiert...";
+            case "sv": return firstLaunch ? "Förbereder spelet (första start)..." : "Uppdaterar spelet...";
+            case "ko": return firstLaunch ? "게임 준비 중 (첫 실행)..." : "게임 업데이트 중...";
+            default: return firstLaunch ? "Preparing the game (first launch)..." : "Updating the game...";
+        }
+    }
+
+    private String readAsset(String name) throws IOException {
+        try (InputStream in = getAssets().open(name)) {
+            ByteArrayOutputStream out = new ByteArrayOutputStream();
+            byte[] buf = new byte[256];
+            int n;
+            while ((n = in.read(buf)) > 0) out.write(buf, 0, n);
+            return new String(out.toByteArray(), StandardCharsets.US_ASCII);
+        }
+    }
+}
